# Home-Buying Intelligence Platform — environment configuration
# Copy to .env and fill in. Never commit .env.

# --- Paths ---
# Root for the SQLite DB, raw download cache, photos and backups. A relative
# path resolves against backend/ (not the shell's CWD); absolute paths work too.
DATA_DIR=./data
# Optional explicit DB path; defaults to ${DATA_DIR}/hb.sqlite3
# DATABASE_PATH=
# Raw download cache retention: dated folders under ${DATA_DIR}/raw/<source>/
# older than this many days are deleted at the tail of `hb pipeline daily`
# (also `hb prune-raw`). Upstream restates its history every release, so the
# newest folder holds everything; 0 keeps every folder forever (each Redfin
# release is ~5.5 GB, each Zillow day ~210 MB).
RAW_KEEP_DAYS=90

# --- Target geography ---
# Cities, ZIPs, counties, tax rates, time zone, map view and the shopping price
# band live in a TOML file, not here. Resolution order: GEOGRAPHY_FILE, then
# <repo-root>/geography.toml (gitignored), then the packaged example
# backend/hb/geographies/<GEOGRAPHY>.toml. Write yours with `make setup`
# (asks your state, cities and price range; docs/packs/README.md §1).
# GEOGRAPHY=sf_peninsula
# GEOGRAPHY_FILE=

# --- Open houses (hb pipeline open-houses; docs/05 §4c) ---
# Seed for the distance origin on the Open Houses page. Editable on that page
# afterwards (stored in the DB); geocoded once via the free US Census geocoder.
# HOME_ADDRESS=123 Main St, Yourtown, ST 00000
# Comma-separated source names from hb/open_houses/sources/REGISTRY
OPEN_HOUSE_SOURCES=realtor,redfin
# Schedule slots, local wall-clock (docs/05 §2). The scheduled tasks fire hourly
# with --catch-up and run a job only when its latest slot has no completed run.
# SCAN_TIMES=05:00,15:00
# DAILY_TIMES=04:00
# Route planner drive-time estimate: straight-line miles x detour factor at avg mph
ROUTE_AVG_MPH=25
ROUTE_DETOUR_FACTOR=1.3

# --- Zillow research CSVs (docs/03 §1.2) ---
# Public files whose URLs drift occasionally; override only when Zillow moves them.
# ZILLOW_ZHVI_ZIP_URL=https://files.zillowstatic.com/research/public_csvs/zhvi/Zip_zhvi_uc_sfr_tier_0.33_0.67_sm_sa_month.csv
# ZILLOW_ZHVI_CITY_URL=https://files.zillowstatic.com/research/public_csvs/zhvi/City_zhvi_uc_sfr_tier_0.33_0.67_sm_sa_month.csv
# ZILLOW_ZORI_ZIP_URL=https://files.zillowstatic.com/research/public_csvs/zori/Zip_zori_uc_sfrcondomfr_sm_month.csv

# --- API keys ---
# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# RentCast (free Developer tier = 50 req/mo): https://app.rentcast.io/app/api
RENTCAST_API_KEY=
# Hard monthly call ceiling enforced by the budget guard (45 on free tier; 950 on Foundation)
RENTCAST_MONTHLY_LIMIT=45
# SchoolDigger (free developer plan): https://developer.schooldigger.com/
# Adds statewide rankings for the geography's state (hb pipeline schooldigger-ratings)
SCHOOLDIGGER_APP_ID=
SCHOOLDIGGER_APP_KEY=
# Daily call ceiling enforced by the budget guard (free plan = 20/day; the
# pipeline converges across daily runs, ~1-3 calls per assigned district)
SCHOOLDIGGER_DAILY_LIMIT=18
# California only: CAASPP results year read by `hb pipeline school-ratings`
# CAASPP_YEAR=2024

# --- Optional Zillow wrapper (off by default; breakage-prone — docs/03 §3.2) ---
ZILLOW_WRAPPER_ENABLED=false
# RAPIDAPI_KEY=

# --- Photos ---
# Download listing images to ${DATA_DIR}/photos/ (personal reference only; never redistribute)
SAVE_PHOTOS=true

# --- Alerts ---
# Channels: comma-separated subset of: log,toast,pushover,email. `log` writes one
# line per alert to the server log and works on every OS; `toast` is a Windows
# desktop notification and is silently unavailable elsewhere. An alert counts as
# delivered once ANY channel succeeds and `log` always succeeds, so on a headless
# server run `pushover` (or `email`) alone: a failed push is then retried next run.
ALERT_CHANNELS=toast,log
# Pushover phone push (https://pushover.net) — required only if the pushover
# channel is enabled. An application token can only send to this user key, so a
# leaked pair lets someone page you and nothing more; regenerate it on the dashboard.
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# SMTP (e.g. Gmail with an app password) — required only if email channel enabled
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_TO=
# Base URL used in alert links: the port `hb serve` listens on. For LAN sharing set it
# to http://<pc-name>.local:18800 (docs/11 §2); with Tailscale on your computer to
# https://<pc-name>.<tailnet>.ts.net (docs/11 §2c); in a VM or on an alternate machine to
# https://hb.<tailnet>.ts.net (below).
APP_BASE_URL=http://localhost:18800

# --- LAN server (hb serve) ---
# Plain HTTP, bound on 0.0.0.0 (ops/windows-lan.ps1 scopes the firewall rule to the LAN).
# HB_HTTP_PORT=18800
# The hourly catch-up check inside `hb serve`: while the app is open it runs any
# scan whose slot has no run yet (docs/05 §2). The OS schedule from `make start`
# runs the same jobs whether or not the app is open; set this to false only where
# system timers do the work (the home server's unit sets it).
# HB_SERVE_SCHEDULER=true

# --- Home server (docs/16; docs/11 §2b) ---
# The server's own /srv/hb/app/.env (mode 600; never shipped by `make deploy-server`)
# sets, beside the API keys above:
# DATA_DIR=/srv/hb/data
# HB_HTTP_PORT=18800
# HB_SERVE_SCHEDULER=false   (ops/linux/hb.service sets it too; the timers run the jobs)
# APP_BASE_URL=https://hb.<tailnet>.ts.net
# ALERT_CHANNELS=pushover
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# APP_BASE_URL is also where ops/deploy-server.sh polls /api/ops/health after a deploy.
